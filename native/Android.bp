cc_library_shared {
    name: "libar-topology",
    vendor: true,
    srcs: [
        "bindings.cpp",
        "defaults.cpp",
        "prepare.cpp",
        "runtime.cpp",
    ],
    export_include_dirs: ["include"],
    export_shared_lib_headers: ["libtinyalsa"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    header_libs: ["libarosal_headers"],
    shared_libs: [
        "libjsoncpp",
        "libar-acdb",
        "libtinyalsa",
    ],
}

cc_test_host {
    name: "ar-topology-runtime-test",
    srcs: [
        "bindings.cpp",
        "defaults.cpp",
        "prepare.cpp",
        "runtime.cpp",
        "tests/runtime_test.cpp",
    ],
    local_include_dirs: ["include"],
    include_dirs: [
        "hardware/qcom-caf/sm8650/audio/graphservices/acdb/api",
        "hardware/qcom-caf/sm8650/audio/graphservices/ar_osal/api",
        "external/tinyalsa/include",
        "bionic/libc/kernel/uapi",
    ],
    shared_libs: ["libjsoncpp"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-UNDEBUG"],
    gtest: false,
    target: {
        darwin: {
            enabled: false,
        },
    },
}

cc_test_host {
    name: "ar-topology-bindings-test",
    srcs: ["bindings.cpp", "tests/bindings_test.cpp"],
    local_include_dirs: ["include"],
    shared_libs: ["libjsoncpp"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-UNDEBUG"],
    gtest: false,
}

cc_test_host {
    name: "ar-topology-prepare-test",
    srcs: [
        "defaults.cpp",
        "prepare.cpp",
        "tests/prepare_test.cpp",
    ],
    local_include_dirs: ["include"],
    include_dirs: [
        "hardware/qcom-caf/sm8650/audio/graphservices/acdb/api",
        "hardware/qcom-caf/sm8650/audio/graphservices/ar_osal/api",
        "external/tinyalsa/include",
        "bionic/libc/kernel/uapi",
    ],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-UNDEBUG"],
    gtest: false,
    target: {
        darwin: {
            enabled: false,
        },
    },
}
