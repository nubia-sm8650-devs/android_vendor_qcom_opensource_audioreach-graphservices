cc_binary_host {
    name: "ar-acdb-topology",
    srcs: [
        "main.cpp",
        "native.cpp",
        "compiler.cpp",
        "corpus.cpp",
        "topology.cpp",
        "source.cpp",
        "factoring.cpp",
        "ownership.cpp",
        "qualification.cpp",
        "endpoints.cpp",
        "board.cpp",
        "hardware.cpp",
        "routing.cpp",
        "frontends.cpp",
    ],
    include_dirs: [
        "hardware/qcom-caf/sm8650/audio/graphservices/uapi",
        "bionic/libc/kernel/uapi",
    ],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    static_libs: ["libar-acdb-topology-host"],
    shared_libs: [
        "libjsoncpp",
        "libxml2",
        "libfdt",
    ],
    target: {
        darwin: {
            enabled: false,
        },
    },
}
