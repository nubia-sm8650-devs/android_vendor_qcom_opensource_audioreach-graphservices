cc_binary_host {
    name: "ar-acdb-topology",
    srcs: [
        "main.cpp",
        "native.cpp",
        "compiler.cpp",
    ],
    include_dirs: ["bionic/libc/kernel/uapi"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    static_libs: ["libar-acdb-topology-host"],
    shared_libs: ["libjsoncpp"],
    target: {
        darwin: {
            enabled: false,
        },
    },
}

python_test_host {
    name: "ar-acdb-topology-test",
    main: "tests/compiler_test.py",
    srcs: ["tests/compiler_test.py"],
    data: [":ar-acdb-topology"],
    target: {
        darwin: {
            enabled: false,
        },
    },
}
