cc_library_shared {
    name: "libar-gsl",
    owner: "qti",
    vendor: true,

    cflags: [
        "-D_ANDROID_",
        "-DGSL_DEBUG_ENABLE",
        "-DGSL_EXT_MEM_CACHE_DISABLE",
        "-DGSL_LOG_PKT_ENABLE",
        "-DGSL_PKT_LOG_PATH=\"/data/vendor/audio/gsl_log.bin\"",
        "-Wno-gnu-designator",
        "-Wno-shorten-64-to-32",
        "-Wno-sign-compare",
        "-Wno-tautological-compare",
        "-Wno-typedef-redefinition",
        "-Wno-unused-function",
        "-Wno-unused-label",
        "-Wno-unused-local-typedef",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],

    srcs: select(soong_config_variable("qtiaudio", "feature_native_topology"), {
        "true": [],
        default: [
            "src/gsl_common.c",
            "src/gsl_datapath.c",
            "src/gsl_dls_client.c",
            "src/gsl_dynamic_module_mgr.c",
            "src/gsl_global_persist_cal.c",
            "src/gsl_graph.c",
            "src/gsl_hw_rsc_mgr.c",
            "src/gsl_main.c",
            "src/gsl_mdf_utils.c",
            "src/gsl_msg_builder.c",
            "src/gsl_rtc.c",
            "src/gsl_rtc_main.c",
            "src/gsl_shmem_mgr.c",
            "src/gsl_spf_ss_state.c",
            "src/gsl_subgraph.c",
            "src/gsl_subgraph_pool.c",
        ],
    }),

    whole_static_libs: select(soong_config_variable("qtiaudio", "feature_native_topology"), {
        "true": ["libar-gsl-native"],
        default: [],
    }),

    export_include_dirs: [
        "api",
        "dls_client_api",
        "hw_rsc_api",
        "rtc_api",
    ],

    local_include_dirs: [
        "api",
        "dls_client_api",
        "hw_rsc_api",
        "inc",
        "rtc_api",
    ],

    header_libs: [
        "libspf-headers",
    ],

    shared_libs: [
        "libar-acdb",
        "libar-gpr",
        "liblx-ar_util",
        "liblx-osal",
    ] + select(soong_config_variable("qtiaudio", "feature_native_topology"), {
        "true": [
            "libar-topology",
            "libjsoncpp",
            "libtinyalsa",
        ],
        default: [],
    }),
}

filegroup {
    name: "ar-gsl-native-sources",
    srcs: [
        "native/acdb.cpp",
        "native/compress.cpp",
        "native/gsl.cpp",
        "native/init.cpp",
        "native/tuning.cpp",
    ],
}

cc_library_static {
    name: "libar-gsl-native",
    vendor: true,
    srcs: [":ar-gsl-native-sources"],
    local_include_dirs: [
        "api",
        "dls_client_api",
        "rtc_api",
    ],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    header_libs: ["libarosal_headers", "libspf-headers"],
    shared_libs: [
        "libar-acdb",
        "libar-topology",
        "libjsoncpp",
        "libtinyalsa",
    ],
}

cc_test_host {
    name: "ar-gsl-native-test",
    srcs: [
        ":ar-gsl-native-sources",
        ":ar-topology-runtime-sources",
        ":ar-topology-startup-sources",
        "native/tests/gsl_test.cpp",
    ],
    local_include_dirs: [
        "api",
        "dls_client_api",
        "native",
        "rtc_api",
    ],
    include_dirs: [
        "hardware/qcom-caf/sm8650/audio/graphservices/acdb/api",
        "hardware/qcom-caf/sm8650/audio/graphservices/ar_osal/api",
        "hardware/qcom-caf/sm8650/audio/graphservices/native",
        "hardware/qcom-caf/sm8650/audio/graphservices/native/include",
        "hardware/qcom-caf/sm8650/audio/graphservices/native/tests",
        "hardware/qcom-caf/sm8650/audio/graphservices/spf/api",
        "hardware/qcom-caf/sm8650/audio/graphservices/spf/api/apm",
        "hardware/qcom-caf/sm8650/audio/graphservices/spf/api/ar_utils",
        "external/tinyalsa/include",
        "bionic/libc/kernel/uapi",
    ],
    shared_libs: ["libjsoncpp"],
    cpp_std: "c++17",
    cppflags: ["-fexceptions"],
    cflags: ["-Wall", "-Wextra", "-Werror", "-UNDEBUG"],
    ldflags: ["-Wl,--wrap=open,--wrap=ioctl"],
    gtest: false,
    target: {
        darwin: {
            enabled: false,
        },
    },
}
